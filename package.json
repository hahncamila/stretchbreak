{
  "name": "stretchbreak",
  "productName": "StretchBreak",
  "version": "1.0.3",
  "description": "Assistente desktop de pausas, postura e alongamentos.",
  "author": "Camila Moreira Hahn",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "build": "tsc -b && vite build",
    "electron:start": "npm run build && electron .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "lint": "eslint .",
    "preview": "vite preview",
    "publish": "npm run build && electron-forge publish"
  },
    "config": {
    "forge": {
      "packagerConfig": {
        "name": "StretchBreak",
        "executableName": "StretchBreak",
        "asar": true,
        "icon": "./electron/assets/icon"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "platforms": [
            "win32"
          ],
          "config": {
            "name": "StretchBreak",
            "authors": "Camila Moreira Hahn",
            "description": "Assistente desktop de pausas, postura e alongamentos.",
            "setupExe": "StretchBreak-Setup.exe",
            "setupIcon": "./electron/assets/icon.ico",
            "noMsi": true
          }
        }
      ],
     "publishers": [
  {
    "name": "@electron-forge/publisher-github",
    "config": {
      "repository": {
        "owner": "hahncamila",
        "name": "stretchbreak"
      },
      "prerelease": false
    }
  }
]
    }
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.1.1",
    "@mui/material": "^9.1.2",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "wait-on": "^9.0.10"
  }
}
